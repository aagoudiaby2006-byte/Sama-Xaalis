# Copy to .env.local for local development (never commit .env.local).
# For EAS builds, create these as EAS environment variables (expo.dev > Project > Environment variables),
# visibility "Plain text" (they are public by nature and end up in the app bundle).
#
# ONLY public values here. Secrets (Supabase service_role key, SMS provider credentials,
# Wave / Orange Money credentials) go into Supabase Edge Function secrets, never into the app.

# Supabase project URL and anon (public) key — Dashboard > Project Settings > API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public pages required by the App Store and Google Play (https only).
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
